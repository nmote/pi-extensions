{
  "name": "pi-extensions",
  "private": true,
  "version": "0.1.0",
  "description": "Pi extensions for approvals, supervised agents, and persistent work tracking.",
  "license": "MIT",
  "repository": "github:nmote/pi-extensions",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "./scripts/test",
    "check": "./scripts/check"
  },
  "pi": {
    "extensions": [
      "./exts/agent-config/index.ts",
      "./exts/auto-approve/index.ts",
      "./exts/backlog/index.ts",
      "./exts/cloud-agents/index.ts",
      "./exts/model-list/index.ts",
      "./exts/openai-limits/index.ts",
      "./exts/provider-ids/index.ts",
      "./exts/session-memory/index.ts",
      "./exts/session-topic/index.ts",
      "./exts/small-model/index.ts",
      "./exts/subagents/index.ts",
      "./exts/web/index.ts"
    ]
  },
  "dependencies": {
    "undici": "8.10.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "22.19.19",
    "tsx": "4.23.13",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
